{
  "name": "telao",
  "productName": "Telão",
  "version": "1.7.0",
  "description": "Compartilhamento de tela entre amigos, com captura e compressão pela placa de vídeo",
  "main": "src/main.js",
  "author": "Kaike",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir && node scripts/make-installer.js",
    "dist:zip": "electron-builder --win zip"
  },
  "build": {
    "appId": "br.kaike.telao",
    "productName": "Telao",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/gst",
        "to": "gst"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false,
      "icon": "src/assets/icon.ico"
    },
    "afterPack": "scripts/after-pack.js",
    "protocols": [
      {
        "name": "Convite do Telão",
        "schemes": [
          "telao"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "resedit": "^2.0.3"
  }
}